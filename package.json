{
    "name": "followup",
    "productName": "FollowUp",
    "version": "1.0.1",
    "description": "Offline-first work management desktop app: tasks, email follow-ups, calendar, automation and AI.",
    "main": "./out/main/index.js",
    "author": "Current-I",
    "license": "Apache-2.0",
    "homepage": "https://github.com/miller-hack/FollowUp#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/miller-hack/FollowUp.git"
    },
    "bugs": {
        "url": "https://github.com/miller-hack/FollowUp/issues"
    },
    "private": true,
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
        "test": "vitest run",
        "dist": "node scripts/dist.mjs",
        "icon": "node scripts/make-icon.mjs",
        "test:update": "node tests/release/update-test.mjs",
        "e2e": "electron-vite build && node tests/e2e/smoke.mjs",
        "docs:screenshots": "electron-vite build && node scripts/docs-screenshots.mjs"
    },
    "devDependencies": {
        "@anthropic-ai/sdk": "^0.133.0",
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/sortable": "10.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@fullcalendar/core": "6.1.20",
        "@fullcalendar/daygrid": "6.1.20",
        "@fullcalendar/interaction": "6.1.20",
        "@fullcalendar/react": "6.1.20",
        "@fullcalendar/timegrid": "6.1.20",
        "@tailwindcss/vite": "4.3.3",
        "@tanstack/react-query": "5.104.2",
        "@tanstack/react-virtual": "3.14.13",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@tiptap/core": "3.31.4",
        "@tiptap/extensions": "3.31.4",
        "@tiptap/pm": "3.31.4",
        "@tiptap/react": "3.31.4",
        "@tiptap/starter-kit": "3.31.4",
        "@types/mailparser": "^3.4.6",
        "@types/node": "22.15.0",
        "@types/nodemailer": "8.0.2",
        "@types/react": "19.1.8",
        "@types/react-dom": "19.1.6",
        "@types/smtp-server": "^3.5.10",
        "@vitejs/plugin-react": "5.2.0",
        "clsx": "2.1.1",
        "date-fns": "4.1.0",
        "electron": "44.7.0",
        "electron-builder": "26.15.3",
        "electron-updater": "^6.8.10",
        "electron-vite": "5.0.0",
        "hoodiecrow-imap": "^2.1.0",
        "ical.js": "^2.1.0",
        "imapflow": "2.2.1",
        "jsdom": "30.1.1",
        "lucide-react": "0.511.0",
        "mailparser": "3.9.33",
        "nodemailer": "10.0.13",
        "openai": "^4.104.0",
        "playwright-core": "^1.55.0",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-is": "^19.1.0",
        "react-router-dom": "7.18.4",
        "recharts": "^2.15.4",
        "smtp-server": "3.19.16",
        "tailwindcss": "4.3.3",
        "tsdav": "^2.1.5",
        "typescript": "5.8.3",
        "vite": "7.3.7",
        "vitest": "4.1.11",
        "zod": "^3.25.76",
        "zustand": "5.0.5"
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "esbuild@0.28.2": true,
        "electron-winstaller@5.4.0": true,
        "electron@44.7.0": true
    },
    "overrides": {
        "optimist": {
            "minimist": "1.2.8"
        },
        "@electron/get": {
            "global-agent": "4.1.3"
        }
    }
